{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "xai": {
      "options": {
        "baseURL": "https://aigo.hair/v1",
        "apiKey": "{env:XAI_API_KEY}"
      },
      "models": {
        "grok-4.6": {}
      }
    },
    "google": {
      "options": {
        "baseURL": "https://aigo.hair/v1",
        "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash": {}
      }
    }
  },
  "model": "opencode/deepseek-v4.1-flash-free",
  "mcp": {
    "servers": {
      "reqable": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/npx",
          "-y",
          "reqable-mcp-server"
        ],
        "disabled": false,
        "environment": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "mobile-mcp": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/npx",
          "-y",
          "@mobilenext/mobile-mcp@latest"
        ],
        "disabled": false,
        "environment": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:~/Library/Android/sdk/platform-tools",
          "ANDROID_HOME": "~/Library/Android/sdk",
          "ANDROID_SDK_ROOT": "~/Library/Android/sdk"
        }
      },
      "mitmproxy-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "--directory",
          "~/.local/share/harness-mitmproxy/opencode",
          "--no-config",
          "--python",
          "3.13",
          "--with",
          "mcp<2",
          "--from",
          "mitmproxy-mcp==0.6.1",
          "mitmproxy-mcp"
        ],
        "disabled": false
      }
    }
  },
  "agent": {},
  "mode": {},
  "plugin": [],
  "command": {},
  "username": "super"
}
